<robot name="robotis_manipulator_h" >
  <link name="world">
  </link>

  <joint name="world_fixed" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="link1"/>
  </joint>

  <!-- link 1 -->
  <link name="link1">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator_h_description/meshes/link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator_h_description/meshes/link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

  </link>

  <!-- Joint 1 -->
  <joint name="joint1" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.0 0.0 0.126" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit velocity="6.5" effort="1000" lower="${-pi*0.5}" upper="${pi*0.5}" />
    <dynamics damping="0.7"/>
  </joint>

  <transmission name="tran1">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint1">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor1">
      <hardwareInterface>EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- link 2 -->
  <link name="link2">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator_h_description/meshes/link_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator_h_description/meshes/link_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

  </link>

  <!-- Joint 2 -->
  <joint name="joint2" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <!-- <origin xyz="0.0 0.069 0.033" rpy="0 0 0"/> -->
    <origin xyz="0.0 0 0.033" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="6.5" effort="1000" lower="-1.57" upper="1.57" />
    <dynamics damping="0.7"/>
  </joint>

  <!-- link 3 -->
  <link name="link3">
    <visual>
      <origin xyz="0 0.069 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator_h_description/meshes/link_3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

  </link>

  <!-- Joint 3 -->
  <joint name="joint3" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <!-- <origin xyz="0.03000 -0.01150 0.26400" rpy="0 0 0"/> -->
    <origin xyz="0.03000 0 0.26400" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="6.5" effort="1000" lower="${-pi*0.5}" upper="${pi*0.5}" />
    <dynamics damping="0.7"/>
  </joint>

  <!-- link 4 -->
  <link name="link4">
    <visual>
      <origin xyz="0 0.0575 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator_h_description/meshes/link_4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

  </link>

  <!-- Joint 4 -->
  <joint name="joint4" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <!-- <origin xyz="0.19500 -0.05750 0.03000" rpy="0 0 0"/> -->
    <origin xyz="0.19500 0 0.03000" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit velocity="6.5" effort="1000" lower="${-pi*0.5}" upper="${pi*0.5}" />
    <dynamics damping="0.7"/>
  </joint>

  <!-- link 5 -->
  <link name="link5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator_h_description/meshes/link_5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

  </link>

  <!-- Joint 5 -->
  <joint name="joint5" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <!-- <origin xyz="0.06300 0.04500 0.00000" rpy="0 0 0"/> -->
    <origin xyz="0.06300 0 0.00000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="6.5" effort="1000" lower="${-pi*0.5}" upper="${pi*0.5}" />
    <dynamics damping="0.7"/>
  </joint>

  <!-- link 6 -->
  <link name="link6">

    <visual>
      <origin xyz="0 0.045 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator_h_description/meshes/link_6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

  </link>

  <!-- Joint 6 -->
  <joint name="joint6" type="revolute">
    <parent link="link6"/>
    <child link="end_link"/>
    <!-- <origin xyz="0.12300 -0.04500 0.00000" rpy="0 0 0"/> -->
    <origin xyz="0.12300 0 0.00000" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit velocity="6.5" effort="1000" lower="${-pi*0.5}" upper="${pi*0.5}" />
    <dynamics damping="0.7"/>
  </joint>

  <!-- end link -->
  <link name="end_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator_h_description/meshes/end_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator_h_description/meshes/end_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>

  </link>

</robot>
